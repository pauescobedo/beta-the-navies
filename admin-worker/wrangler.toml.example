name = "the-navies-admin"
main = "worker.js"
compatibility_date = "2026-11-06"

[vars]
ALLOWED_ORIGINS = "https://thenavies.com,https://www.thenavies.com,http://127.0.0.1:4173"

# Añade los valores privados desde la terminal; nunca los escribas aquí:
# npx wrangler secret put TOTP_SECRET
# npx wrangler secret put SESSION_SECRET
